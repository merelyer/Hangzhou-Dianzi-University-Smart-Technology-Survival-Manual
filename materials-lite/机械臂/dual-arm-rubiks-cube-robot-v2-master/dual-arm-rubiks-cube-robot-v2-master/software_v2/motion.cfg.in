# 速度比例
SPEED_FACTOR = 1.0
# 左侧旋转臂零点位置
ARM4_ZERO = 12069
# 右侧旋转臂零点位置
ARM2_ZERO = 8056
# 调整右手指的偏移量，调整这个值，使回零后的右手指间距接近FINGER_INIT
OFFSET_FINGER_1_ZERO = 1.0
# 调整左手指的偏移量，调整这个值，使回零后的左手指间距接近FINGER_INIT
OFFSET_FINGER_3_ZERO = 0.4
# 手指锁紧位置，手指为闭环控制，不需要很精确的值，但是需要保证至少1/100圈（164个编码器计数）的余量来触发电流减半的功能
# 如需修改，需要和动作序列一起改
FINGER_CLAMP = 53
# 手指初始位置，用于放置魔方，52+2*2 = 56mm，与魔方边长保持一致(可以设置的大一点，这样放置魔方更快)
# 同时，这个也是手指电机控制电流的判定依据，小于这个值，电流将被调整为CLAMP_CURRENT
FINGER_INIT = 56.6
# 最大电流(取值范围0-7，分别对应12.5% 25% 37.5% 50% 62.5% 87.5% 100%)
MAX_CURRENT   = 7
# 手指夹紧电流(37.5%)
CLAMP_CURRENT = 2
# 单臂夹持魔方时的电流
SINGLE_CLAMP_CURRENT = 5
# 拧魔方时的速度，如果魔方的润滑比较好，可调大一点
V_TWIST = 650
# 拧魔方时的加速度，在停转不抖动的前提下，尽可能大
A_TWIST = 0.55
# 拧魔方时的加加速度
J_TWIST = 0.05
# autogen use table.py